# --------------------------------------------------------------------------- #
# Plantilla de credenciales — Dashboard de Marketing de Reversal Institute.
# Copia este archivo a `secrets.toml` (mismo dir) y rellena SOLO las plataformas
# que quieras conectar en vivo. Sin credenciales, el dashboard funciona con
# datos de ejemplo / caché.
#
# ⚠️ NUNCA subas secrets.toml a git (ya está en .gitignore).
# --------------------------------------------------------------------------- #

# Google Ads: el dashboard usa el SNAPSHOT de data/cache/google_ads.parquet
# (volcado con scripts/seed_google_ads.py vía el MCP de Claude). Solo hace falta
# rellenar esto si quieres conexión OAuth en vivo desde la propia app.
[google_ads]
developer_token = ""
client_id = ""
client_secret = ""
refresh_token = ""
login_customer_id = "4885772142"   # MCC - Rise Marketing (MCC raíz)
customer_id = "2692996145"         # Reversal Institute (269-299-6145)

[meta_ads]
access_token = ""                  # Token de la app / usuario del sistema
ad_account_id = "act_000000000"    # TODO cuenta publicitaria Meta de Reversal
api_version = "v21.0"

[ga4]
property_id = "properties/542276987"   # "Web Reversal" (reversal.institute)
# Pega aquí el JSON del Service Account (como sub-tabla):
[ga4.service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
token_uri = "https://oauth2.googleapis.com/token"

[hubspot]
access_token = ""                  # Private App token (pat-...)
portal_id = "147885062"            # Portal HubSpot de Reversal

# --------------------------------------------------------------------------- #
# SOCIAL ORGÁNICO — cada red se enciende por separado. Que falte una no afecta
# a las demás: la que no tenga credencial se sirve de CSV importado o ejemplo.
#
# Tras rellenar cualquiera de estas secciones:
#     python scripts/verificar_social.py
# --------------------------------------------------------------------------- #

# YouTube. Genera esta sección entera con:
#     python scripts/youtube_refresh_token.py <CLIENT_ID> <CLIENT_SECRET>
# ⚠️ OAuth de la cuenta PROPIETARIA del canal: Analytics no admite service
# account (a diferencia de GA4).
[youtube]
client_id = ""
client_secret = ""
refresh_token = ""
channel_id = ""                    # "UC..." — youtube.com/account_advanced

# Facebook + Instagram orgánico.
# ⚠️ El token de [meta_ads] NO sirve: solo tiene ads_*. Hace falta un token de
# System User con pages_show_list, pages_read_engagement, read_insights,
# instagram_basic, instagram_manage_insights (+ pages_messaging para mensajes)
# Y tener la Página asignada al System User.
[social_meta]
access_token = ""                  # System User del Business
page_id = "1229909610199926"       # Página promocionada por la cuenta de Ads
ig_user_id = ""                    # opcional: se deriva de la Página
api_version = "v21.0"

# LinkedIn. Requiere app NUEVA con Community Management API como ÚNICO producto
# (no convive con Marketing Developer Platform), verificada contra la página y
# aprobada por revisión manual de LinkedIn.
[linkedin]
client_id = ""                     # app "ReversalLinkd": 77214n5ht2ek85
client_secret = ""
refresh_token = ""
organization_id = ""               # nº de linkedin.com/company/XXXXXXX/admin
version = "202506"                 # cabecera LinkedIn-Version
